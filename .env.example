# PostgreSQL JDBC configuration. Do not put real credentials in this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Required in the X-API-Key header for the load and admin endpoints. Generate one with: openssl rand -hex 32
APP_API_KEY=

# Optional Kafka overrides used by Docker Compose.
KAFKA_TRADE_DATA_TOPIC=trade-data
KAFKA_CONSUMER_GROUP_ID=demo-trade-data-consumer

# Optional Binance.US endpoint used by the daily fallback query.
BINANCE_API_BASE_URL=https://api.binance.us

# Optional Kimi terminal configuration.
# Leave the key empty unless you enable the terminal locally.
MOONSHOT_API_KEY=
KIMI_API_URL=https://api.moonshot.ai/v1/chat/completions
KIMI_MODEL=kimi-k3
TERMINAL_CHAT_ENABLED=false
