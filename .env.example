# PostgreSQL JDBC configuration. Do not put real credentials in this file.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/YOUR_DATABASE
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# Optional Kafka overrides used by Docker Compose.
KAFKA_TRADE_DATA_TOPIC=trade-data
KAFKA_CONSUMER_GROUP_ID=demo-trade-data-consumer
